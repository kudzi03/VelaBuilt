# VelaBuilt — environment
#
# The site runs correctly with none of these set: the enquiry endpoint falls
# back to the logging adapter. Adding a credential activates its integration
# and nothing else. Copy to .env.local for development.
#
# Never give any value below a NEXT_PUBLIC_ prefix except SITE_URL.

# Public. Canonical URLs, sitemap, robots, OG tags and JSON-LD all derive from
# this. Leave it unset until the domain actually serves this site: unset, the
# build uses the Vercel production *.vercel.app host (or localhost locally).
# See DOMAIN-SETUP.md and src/lib/site-origin.ts.
# NEXT_PUBLIC_SITE_URL=https://velabuilt.com

# 301 the old vela-built.vercel.app host to NEXT_PUBLIC_SITE_URL. Set to 1 only
# after step 4 of DOMAIN-SETUP.md passes. Requires NEXT_PUBLIC_SITE_URL.
# CANONICAL_HOST_REDIRECT=1
# CANONICAL_REDIRECT_FROM=vela-built.vercel.app

# Where inbound enquiries go.
#   email    SMTP send to ENQUIRY_NOTIFY_EMAIL (default hello@velabuilt.com).
#   webhook  signed POST to ENQUIRY_WEBHOOK_URL.
#   log      records that an enquiry arrived, nothing personal. Development and
#            previews only: refuses to run when VERCEL_ENV=production.
# Unset: "email" when SMTP_HOST is set, otherwise "log".
# ENQUIRY_ADAPTER=email

# SMTP for the email adapter — the studio's own mailbox, no form service.
# Google Workspace: turn on 2-Step Verification for the sending account, create
# an app password (Google Account → Security → App passwords), then:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=hello@velabuilt.com
# SMTP_PASS=
# ENQUIRY_FROM_EMAIL=hello@velabuilt.com

# Server-to-server inbound endpoint. Point this at a NEW inbound workflow —
# never at an existing outbound one. See SECURITY.md.
# ENQUIRY_WEBHOOK_URL=https://example.com/webhook/velabuilt-inbound

# Signing key for outbound webhook deliveries (HMAC-SHA256, min 24 chars).
# The receiver should verify x-velabuilt-signature before trusting the payload.
# ENQUIRY_WEBHOOK_SECRET=

# Where enquiries are sent. Defaults to the site's public address.
# ENQUIRY_NOTIFY_EMAIL=hello@velabuilt.com

# ── Vela, the voice guide ────────────────────────────────────────────────────
# Optional. Unset, /api/voice/session returns 503 and a conversation that is
# started says plainly that Vela is unavailable; the site works without it.
#
# Vela is its own agent, duplicated from the original studio agent and
# configured for the website (client tools, grounding, privacy). The original
# agent_9001m347033mfsfbnzk4t695g3f3 is untouched.
# The agent id is not a secret, but keep it server-side so the guide can be
# switched off without a deploy.
# ELEVENLABS_AGENT_ID=agent_4501m357hr66e95rvryg3609nnnv
#
# The API key IS a secret and must never get a NEXT_PUBLIC_ prefix. With it
# set, the route mints a short-lived WebRTC conversation token (voice) or
# signed WebSocket URL (text) server-side, so the browser never sees the key.
# Without it, the route hands out the public agent id and the agent's
# allowlist (velabuilt.com, www.velabuilt.com, vela-built.vercel.app) is the
# only gate. Needs the convai scope only.
# ELEVENLABS_API_KEY=
